{
  "name": "@sororail/sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the SoroRail Soroban payment contracts.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "docs:api": "typedoc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "api:check": "node scripts/api-surface.mjs",
    "api:update": "node scripts/api-surface.mjs --update",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "test:integration": "bash examples/run-integration.sh",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1",
    "sororail-frontend": "file:../.."
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "tsup": "^8.3.5",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
